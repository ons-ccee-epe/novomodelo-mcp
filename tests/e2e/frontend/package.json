{
  "name": "novomodelo-mcp-e2e-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Painel dos resultados da bateria e2e do novomodelo-mcp: lê as rodadas do launcher de dev.",
  "scripts": {
    "dev": "vite",
    "dev:launcher": "node scripts/dev-launcher.mjs",
    "dev:tests": "node scripts/dev-with-tests.mjs",
    "dev:tests:skip": "node scripts/dev-with-tests.mjs --skip-tests",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@radix-ui/themes": "3.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "react-router-dom": "7.18.4",
    "recharts": "2.15.4",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "4.7.0",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "globals": "15.15.0",
    "jsdom": "25.0.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vite": "6.4.4",
    "vitest": "3.2.7"
  },
  "engines": {
    "node": "25.9.0"
  }
}
