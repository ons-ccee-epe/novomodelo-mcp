{
  "name": "cobre-mcp-e2e-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Frontend do dashboard de resultados dos testes E2E do <repositório anterior> (consome os JSON de tests/e2e/results e tests/e2e/metrics; nao gera HTML).",
  "scripts": {
    "dev": "vite",
    "dev:launcher": "node scripts/dev-launcher.mjs",
    "dev:tests": "node scripts/dev-with-tests.mjs",
    "dev:tests:skip": "node scripts/dev-with-tests.mjs --skip-tests",
    "build": "tsc -b && vite build",
    "postbuild": "node scripts/copy-data.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@radix-ui/themes": "^3.2.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.9.1",
    "recharts": "^2.15.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^15.15.0",
    "jsdom": "^25.0.1",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^6.3.5",
    "vitest": "^3.2.4"
  }
}
